rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins collection: allows credential verification for admin site
    // (Document ID is the admin's email, containing the password field)
    match /admins/{emailId} {
      allow read, write: if true;
    }

    // Students directory: managed by administrators and displayed for rating
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Rating criteria: managed by administrators
    match /criteria/{criterionId} {
      allow read, write: if true;
    }

    // Anonymous Reviews: readable and moderated
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Individual peer ratings
    match /ratings/{ratingId} {
      allow read, write: if true;
    }

    // Authoritative Aggregates
    match /aggregates/{studentId} {
      allow read, write: if true;
    }

    // User profiles & device tracking
    match /users/{uid} {
      allow read, write: if true;
      match /deviceSessions/{deviceId} {
        allow read, write: if true;
      }
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
