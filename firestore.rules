rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for identity and role verification
    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function isPhyStudent() {
      return isSignedIn() && request.auth.token.email.matches('^s-\\d{10}@phy\\.du\\.ac\\.bd$');
    }

    function isBatch2024() {
      return isSignedIn() && request.auth.token.email.matches('^s-2024\\d{6}@phy\\.du\\.ac\\.bd$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default: deny everything
    match /{document=**} {
      allow read, write: false;
    }

    // Students directory: readable by any verified physics student or admin.
    // Managed exclusively by administrators.
    match /students/{studentId} {
      allow read: if isPhyStudent() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Rating criteria: readable by any verified student, managed by admin.
    match /criteria/{criterionId} {
      allow read: if isPhyStudent() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // User profiles & device tracking
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.email == request.auth.token.email;
      allow delete: if isAdmin();

      match /deviceSessions/{deviceId} {
        allow read, write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      }
    }

    // Ratings collection:
    // CRITICAL PRIVACY REQUIREMENT:
    // Raw ratings are NEVER readable by ordinary students to guarantee anonymity.
    // Only administrators or backend aggregators can read ratings.
    // 2024 batch students can ONLY create their single deterministic rating.
    // Ratings are immutable: NO update, NO delete.
    match /ratings/{ratingId} {
      allow read: if isAdmin();
      allow create: if isBatch2024() &&
        ratingId == request.auth.uid + '_' + request.resource.data.targetStudentId &&
        request.resource.data.reviewerUid == request.auth.uid &&
        request.resource.data.targetStudentId is string &&
        request.resource.data.scores is map;
      allow update, delete: if false;
    }

    // Anonymous Reviews:
    // Public department students can read only visible reviews.
    // Reviewer UID is not present in public review documents.
    // 2024 batch students can create a review linked to their deterministic ratingId.
    // Only admins can update visibility (hide/restore).
    match /reviews/{reviewId} {
      allow read: if isAdmin() || (isPhyStudent() && resource.data.visible == true);
      allow create: if isBatch2024() &&
        request.resource.data.ratingId.matches('^' + request.auth.uid + '_.*') &&
        request.resource.data.visible == true &&
        request.resource.data.reviewText is string &&
        request.resource.data.reviewText.size() <= 500;
      allow update, delete: if isAdmin();
    }

    // Authoritative Aggregates:
    // Public department students and admins can read aggregates.
    // Normal clients CANNOT write or alter aggregates (only admins or backend functions).
    match /aggregates/{studentId} {
      allow read: if isPhyStudent() || isAdmin();
      allow write: if isAdmin();
    }

    // Administrator credentials and protected data
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
